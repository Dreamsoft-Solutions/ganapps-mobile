    "check:docs": "node scripts/check-docs.mjs",
    "check:tokens": "node scripts/check-tokens.mjs --docs",
    "start": "expo start",
    "dev": "expo start --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "oxlint --format unix src/ pact/",
    "lint:landmines": "oxlint --config ./ultracite.oxlint.mts --format unix src/ pact/",
    "lint:fix": "npm run lint -- --fix",
    "format": "biome format --write src/ pact/",
    "check": "biome format src/ pact/ && npm run lint",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "eas:build": "eas build",
    "eas-build-post-install": "node scripts/check-play-release.cjs",
    "check:play-release": "node --env-file-if-exists=.env scripts/check-play-release.cjs --production",
    "eas:preview": "eas build --platform all --profile preview",
    "prepare": "husky"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-native-async-storage/async-storage"
      ]
    }
  },
  "private": true
