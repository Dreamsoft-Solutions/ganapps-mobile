# API — include the server's /api prefix and its /v1 version segment.
# localhost is the device, not your machine: use http://10.0.2.2:3000/api/v1 on
# an Android emulator, or your host's LAN IP on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Public website origin for shared Friend Code and Ganap links.
# Local HTTP is allowed for development (use your computer's LAN address on a physical device).
# EAS preview/production must set a public HTTPS origin for Android App Links and iOS Universal Links.
EXPO_PUBLIC_WEB_URL=

# Public HTTPS pages, required in the EAS production environment.
# The deletion resource must actually accept account and associated-data requests.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_ACCOUNT_DELETION_URL=

# Firebase Remote Config
# Download google-services.json (Android) and GoogleService-Info.plist (iOS)
# from Firebase Console -> Project Settings -> Your Apps
# Place them in the project root directory
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Native Firebase configuration files
# The downloaded Android config must include an Android OAuth client for
# com.ganapps.app after its SHA-1/SHA-256 fingerprints are registered.
# GOOGLE_SERVICES_JSON=/absolute/path/to/google-services.json
# GOOGLE_SERVICE_INFO_PLIST=/absolute/path/to/GoogleService-Info.plist

# Mapbox
# Add your Mapbox public access token here. Keep this secret out of version control.
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Feature Flag overrides (set any flag via env var for local dev)
# EXPO_PUBLIC_FEATURE_FLAG_EXAMPLE_FEATURE=true
EXPO_PUBLIC_FEATURE_FLAG_ENV_OVERRIDE=true
EXPO_PUBLIC_FEATURE_FLAG_CACHE_TTL=300

EXPO_PUBLIC_FEATURE_FLAG_REMOTE_CONFIG_PARAMETER=mobile_dev
