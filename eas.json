{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_FEATURE_FLAG_REMOTE_CONFIG_PARAMETER": "mobile_dev"
      },
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": true
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "image": "macos-tahoe-26.5-xcode-26.6"
      },
      "env": {
        "APP_ENV": "production",
        "EXPO_PUBLIC_FEATURE_FLAG_ENV_OVERRIDE": "false",
        "EXPO_PUBLIC_FEATURE_FLAG_REMOTE_CONFIG_PARAMETER": "mobile_prod"
      }
    },
    "testflight": {
      "extends": "production",
      "environment": "preview",
      "android": {
        "distribution": "internal",
        "buildType": "apk",
        "autoIncrement": false
      },
      "env": {
        "EXPO_PUBLIC_FEATURE_FLAG_REMOTE_CONFIG_PARAMETER": "mobile_dev"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6815148007",
        "appleTeamId": "ZS3U26AMH9"
      }
    },
    "testflight": {
      "extends": "production"
    }
  }
}
